FOLIO_ENV=development
FOLIO_HOST=127.0.0.1
FOLIO_PORT=8000
FOLIO_DATABASE_URL=sqlite:///./data/folio.db
FOLIO_DATA_DIR=./data
FOLIO_REDIS_URL=redis://127.0.0.1:6379/0
FOLIO_QUEUE_MODE=auto
FOLIO_RETENTION_DAYS=7
FOLIO_MAX_FILE_MB=50
FOLIO_MAX_PAGES=100
# Linux/macOS 上若系统没有可用 CJK 字体，可指定开源字体文件：
# FOLIO_FONT_PATH=/absolute/path/to/NotoSansCJK-Regular.otf
